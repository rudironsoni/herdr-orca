{
  "name": "@rudironsoni/herdr-orca",
  "version": "0.1.0",
  "description": "Herdr plugin that attaches stock Orca to Herdr-owned terminals.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudironsoni/herdr-orca.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "dist/herdr-orca.mjs",
    "src",
    "herdr-plugin.toml",
    "README.md",
    "LICENSE",
    "CONTEXT.md",
    "AGENTS.md"
  ],
  "bin": {
    "herdr-orca": "./dist/herdr-orca.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "doctor": "node dist/herdr-orca.mjs doctor",
    "pack:plugin": "node scripts/pack-plugin.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  }
}
